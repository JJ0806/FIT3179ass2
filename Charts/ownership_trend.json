{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How has bird ownership changed?",
    "subtitle": [
      "Australian households owning birds (%), selected survey years",
      "Lines connect survey estimates; they do not show annual measurements."
    ],
    "anchor": "start"
  },
  "width": 640,
  "height": 300,
  "background": "white",
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#E8ECEF",
      "domain": false,
      "labelLimit": 260
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 12,
      "labelLimit": 300,
      "titleLimit": 300
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12,
      "subtitleColor": "#59656D",
      "offset": 18
    }
  },
  "data": {
    "url": "../Data/bird_ownership_trend.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "ownership_pct": "number"
      }
    }
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 85
    },
    "color": "#157A6E"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Survey year",
      "axis": {
        "format": "d",
        "values": [
          2016,
          2022,
          2025
        ]
      },
      "scale": {
        "zero": false
      }
    },
    "y": {
      "field": "ownership_pct",
      "type": "quantitative",
      "title": "Households (%)",
      "scale": {
        "domain": [
          0,
          15
        ]
      },
      "axis": {
        "labelExpr": "datum.value + '%'"
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "title": "Survey year",
        "format": "d"
      },
      {
        "field": "ownership_pct",
        "type": "quantitative",
        "title": "Households (%)",
        "format": ".1f"
      },
      {
        "field": "source",
        "type": "nominal",
        "title": "Source"
      }
    ]
  }
}
